  "interpretation": [
    "TechnoType::ReadINI 0x712170 derives type+0xC9C at 0x715793..0x7157AE: clear; load Primary pointer from +0x898; if nonnull and signed Weapon Damage at +0xA4 is greater than zero, set one.",
